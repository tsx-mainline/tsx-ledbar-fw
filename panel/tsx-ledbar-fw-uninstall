#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# tsx-ledbar-fw-uninstall: load the stock firmware back into the USB LED bar.
#
# The stock image is Crestron software and is not part of any package. The
# mainline installer keeps the panel's own copy in /data/tsx/vendor/. Give a
# path when the file is elsewhere:
#
#   tsx-ledbar-fw-uninstall [statussign_VERSION.upg]
STOCK_DIR=${TSX_LEDBAR_STOCK_DIR:-/data/tsx/vendor}
MARKER=${TSX_LEDBAR_FW_MARKER:-/data/tsx/ledbar-fw.installed}
FLASH=${TSX_LEDBAR_FLASH:-tsx-ledbar-flash}
LIB=${TSX_LEDBAR_FW_LIB:-/usr/local/lib/tsx-ledbar-fw}

die() { echo "tsx-ledbar-fw-uninstall: $*" >&2; exit 1; }

# tsx-esphome and tsx-voice read the bar firmware name (the effect list) only
# at start. Restart each one that runs. A failed restart does not fail the
# flash.
restart_bar_users() {
	command -v rc-service >/dev/null 2>&1 || return 0
	for s in tsx-esphome tsx-voice; do
		rc-service --exists "$s" 2>/dev/null || continue
		rc-service "$s" status >/dev/null 2>&1 || continue
		echo "restarting $s (it reads the bar firmware name at start)"
		rc-service "$s" restart >/dev/null 2>&1 ||
			echo "tsx-ledbar-fw-uninstall: $s did not restart. Restart it by hand." >&2
	done
	return 0
}

[ "$(id -u)" = 0 ] || die "run as root"
if [ -n "$1" ]; then
	IMAGE=$1
else
	IMAGE=$(ls "$STOCK_DIR"/statussign_*.upg 2>/dev/null | sort -V | tail -1)
	[ -n "$IMAGE" ] || die "no stock image in $STOCK_DIR (statussign_*.upg). Copy it from the panel's stock system (vendor/firmware/) or give its path."
fi
[ -r "$IMAGE" ] || die "image not found: $IMAGE"
python3 "$LIB"/tsx-upg.py verify "$IMAGE" || die "the image fails its checks, nothing sent"
"$FLASH" flash "$IMAGE" || die "flash failed, the bar keeps its bootloader: run the uninstall again"
restart_bar_users
rm -f "$MARKER"
echo "stock LED bar firmware restored from $IMAGE"
