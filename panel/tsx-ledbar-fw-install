#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# tsx-ledbar-fw-install: load the tsx-ledbar firmware into the USB LED bar.
#
#   tsx-ledbar-fw-install            load the packaged image
#   tsx-ledbar-fw-install FILE.upg   load another image
#   tsx-ledbar-fw-install --check    exit 0 when the bar runs the packaged version
#   tsx-ledbar-fw-install --recover-image
#                                    print the image that --recover loads, exit 3 when
#                                    there is none
#   tsx-ledbar-fw-install --recover  load that image into a bar in bootloader mode
#   tsx-ledbar-fw-install --status   show the bar, the packaged image and a pending load
#   tsx-ledbar-fw-install --note-upgrade
#                                    for the post-upgrade hook: record that a newer
#                                    image is waiting. It never loads the bar.
#
# A package upgrade never loads the bar. A load that stops half way (power loss
# after the erase) can leave a bar that USB cannot recover, so a person starts
# every load of the application. After an upgrade the hook writes the file
# ledbar-fw.pending in /data/tsx (the version of the bar and the new version).
# Run tsx-ledbar-fw-install to load the image. A good load removes the file.
#
# --recover is for the tsx-ledbar service (tsx-ledbard). It loads the image that
# the panel is set up for. The marker means TSX-LEDBAR: the packaged image.
# Without the marker the panel keeps the stock firmware, and the newest stock
# image in /data/tsx/vendor/ is loaded, as tsx-ledbar-fw-uninstall does. Only
# when the panel has no stock image, the packaged image is the last choice.
# --recover keeps the tsx-ledbar service running, because the service calls it.
# It does not write or remove the marker, and it does not touch a bar that
# runs its application. A bar in bootloader mode has no application to lose.
#
# The install writes a marker in /data/tsx (ledbar-fw.installed). While the
# marker exists, a package upgrade records a newer image as pending. The marker
# goes away with tsx-ledbar-fw-uninstall, which loads the stock image back.
IMAGE=${TSX_LEDBAR_FW_IMAGE:-/usr/share/tsx-ledbar-fw/tsx-ledbar.upg}
MARKER=${TSX_LEDBAR_FW_MARKER:-/data/tsx/ledbar-fw.installed}
PENDING=${TSX_LEDBAR_FW_PENDING:-/data/tsx/ledbar-fw.pending}
STOCK_DIR=${TSX_LEDBAR_STOCK_DIR:-/data/tsx/vendor}
FLASH=${TSX_LEDBAR_FLASH:-tsx-ledbar-flash}
LIB=${TSX_LEDBAR_FW_LIB:-/usr/local/lib/tsx-ledbar-fw}
LEDS=${TSX_LEDBAR_LEDS:-/sys/class/leds/tsx:rgb:bar}
USB=${TSX_LEDBAR_USB:-/sys/bus/usb/devices}

die() { echo "tsx-ledbar-fw-install: $*" >&2; exit 1; }

# tsx-esphome and tsx-voice read the bar firmware name (the effect list) only
# at start. Restart each one that runs. A failed restart does not fail the
# flash.
restart_bar_users() {
	command -v rc-service >/dev/null 2>&1 || return 0
	for s in tsx-esphome tsx-voice; do
		rc-service --exists "$s" 2>/dev/null || continue
		rc-service "$s" status >/dev/null 2>&1 || continue
		echo "restarting $s (it reads the bar firmware name at start)"
		rc-service "$s" restart >/dev/null 2>&1 ||
			echo "tsx-ledbar-fw-install: $s did not restart. Restart it by hand." >&2
	done
	return 0
}

bar_firmware() {
	cat "$LEDS"/firmware 2>/dev/null
}

# true when the bar is on USB in bootloader mode (14be:001a)
bar_in_bootloader() {
	for d in "$USB"/*; do
		[ "$(cat "$d"/idVendor 2>/dev/null)" = 14be ] &&
			[ "$(cat "$d"/idProduct 2>/dev/null)" = 001a ] && return 0
	done
	return 1
}

# Print the image for a bar in bootloader mode, or fail when there is none.
# The same stock image lookup as tsx-ledbar-fw-uninstall.
recover_image() {
	stock=$(ls "$STOCK_DIR"/statussign_*.upg 2>/dev/null | sort -V | tail -1)
	if [ -e "$MARKER" ] && [ -r "$IMAGE" ]; then
		echo "$IMAGE"
	elif [ -n "$stock" ] && [ -r "$stock" ]; then
		echo "$stock"
	elif [ -r "$IMAGE" ]; then
		echo "$IMAGE"
	else
		return 1
	fi
}

# the version in the image header. Fails when the image fails its checks.
image_version() {
	info=$(python3 "$LIB"/tsx-upg.py info "$1") || return 1
	echo "$info" | sed -n 's/^ *version *ok *//p'
}

# what the bar runs, in a few words: "tsx-ledbar 0.1.7", the firmware name
# of another firmware, "bootloader mode" or "no bar"
bar_state() {
	have=$(bar_firmware)
	case $have in
	*"TSX-LEDBAR [v"*"]"*)
		v=${have#*TSX-LEDBAR \[v}
		echo "tsx-ledbar ${v%%]*}";;
	"")
		if bar_in_bootloader; then echo "bootloader mode"; else echo "no bar"; fi;;
	*) echo "\"$have\"";;
	esac
}

# Forget a pending load when the bar runs the packaged version already (a load
# by hand with tsx-ledbar-flash, or a load by an earlier tool). Best effort.
drop_stale_pending() {
	[ -e "$PENDING" ] || return 0
	case $(bar_firmware) in
	*"TSX-LEDBAR [v$1]"*) rm -f "$PENDING" 2>/dev/null;;
	esac
	return 0
}

case $1 in
--note-upgrade)
	# Never loads the bar and never fails the upgrade.
	if [ ! -e "$MARKER" ]; then
		rm -f "$PENDING" 2>/dev/null
		exit 0
	fi
	want=$(image_version "$IMAGE") && [ -n "$want" ] || {
		echo "tsx-ledbar-fw: cannot read the version of $IMAGE, the bar is not touched" >&2
		exit 0
	}
	case $(bar_firmware) in
	*"TSX-LEDBAR [v$want]"*)
		rm -f "$PENDING" 2>/dev/null
		exit 0;;
	esac
	old=$(bar_state)
	{
		echo "old=$old"
		echo "new=tsx-ledbar $want"
		echo "date=$(date '+%F %T')"
	} > "$PENDING" 2>/dev/null ||
		echo "tsx-ledbar-fw: cannot write $PENDING" >&2
	echo "tsx-ledbar-fw: a new bar firmware ($want) is available, the bar runs $old. The upgrade does not load it. Run tsx-ledbar-fw-install to load it."
	exit 0;;
--status)
	want=$(image_version "$IMAGE") && [ -n "$want" ] || want="unknown"
	echo "packaged image: tsx-ledbar $want"
	echo "bar: $(bar_state)"
	if [ -e "$MARKER" ]; then
		echo "marker: installed ($(cat "$MARKER" 2>/dev/null))"
	else
		echo "marker: not installed (package upgrades leave the bar alone)"
	fi
	[ "$want" = unknown ] || drop_stale_pending "$want"
	if [ -e "$PENDING" ]; then
		echo "pending: $(sed -n 's/^old=//p' "$PENDING") -> $(sed -n 's/^new=//p' "$PENDING")"
		echo "Run tsx-ledbar-fw-install to load the packaged image."
	else
		echo "pending: none"
	fi
	exit 0;;
--check)
	want=$(image_version "$IMAGE") && [ -n "$want" ] ||
		die "cannot read the version of $IMAGE"
	have=$(bar_firmware)
	case $have in
	*"TSX-LEDBAR [v$want]"*) drop_stale_pending "$want"; echo "bar runs tsx-ledbar $want"; exit 0;;
	"")
		bar_in_bootloader &&
			die "the LED bar is in bootloader mode. Run tsx-ledbar-fw-install to load the firmware"
		die "no LED bar found";;
	*) echo "bar runs \"$have\", package has $want"; exit 1;;
	esac;;
--recover-image) recover_image || exit 3; exit 0;;
--recover)
	[ "$(id -u)" = 0 ] || die "run as root"
	bar_in_bootloader || { echo "the LED bar is not in bootloader mode, nothing to recover"; exit 0; }
	IMAGE=$(recover_image) || die "no image to load: no packaged image and no stock image in $STOCK_DIR"
	echo "loading $IMAGE into the LED bar"
	"$FLASH" --keep-service flash "$IMAGE" || die "flash failed, the bar keeps its bootloader"
	restart_bar_users
	echo "LED bar recovered from bootloader mode"
	exit 0;;
"") ;;
-*) die "usage: tsx-ledbar-fw-install [FILE.upg | --check | --status | --recover-image | --recover]";;
*) IMAGE=$1;;
esac

[ "$(id -u)" = 0 ] || die "run as root"
[ -r "$IMAGE" ] || die "image not found: $IMAGE"
if [ -e "$PENDING" ]; then
	echo "loading $IMAGE: $(sed -n 's/^new=//p' "$PENDING") (the bar runs $(sed -n 's/^old=//p' "$PENDING"))"
fi
"$FLASH" flash "$IMAGE" || die "flash failed, the bar keeps its bootloader: run the install again"
restart_bar_users
mkdir -p "$(dirname "$MARKER")"
date '+%F %T' > "$MARKER"
rm -f "$PENDING"
echo "tsx-ledbar firmware installed. A package upgrade tells you when a newer image is available."
echo "Run tsx-ledbar-fw-install again to load it. tsx-ledbar-fw-uninstall puts the stock firmware back."
