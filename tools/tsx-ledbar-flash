#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""tsx-ledbar-flash: load an application image into the xx60 USB LED bar.

The bar (USB 14be:001b) takes a new application through its bootloader.
The host sends a "prepare" packet on the Cresnet interface, the bar
restarts into the bootloader (14be:001a, one interface), and the host
sends the S-records of the .upg file as Cresnet packets, block by block
with an acknowledgement after each block. See docs/update-protocol.md.

Runs on the panel as root. It uses usbdevfs and the raw attribute of the
kernel driver leds-crestron-stm32, no libusb. The tsx-ledbar service is
stopped while the flash runs and started again at the end.

  tsx-ledbar-flash info                show the bar, its mode and version
  tsx-ledbar-flash flash FILE.upg      check the file, then load it
  tsx-ledbar-flash console CMD...      one application console command
  tsx-ledbar-flash enter-bootloader    send the prepare packet only
  tsx-ledbar-flash btl-read [MS]       read bootloader packets for MS ms
  tsx-ledbar-flash port-reset          disable the USB port for 3 s, enable it

port-reset: a USB bus reset of the bar's port. It does not cut the bar's
supply (the panel keeps VBUS on), but a bar left in a mode that does not
answer on USB came back to its application after it. The bootloader
keeps an image only when its CRC is good, so a bar with an interrupted
load starts in bootloader mode again and takes a new load. A real power
cycle needs a power cycle of the panel.
"""
import ctypes
import errno
import fcntl
import glob
import importlib.util
import os
import struct
import subprocess
import sys
import time

VID = '14be'
PID_APP = '001b'
SERVICE = '/etc/init.d/tsx-ledbar'
LED_RAW = '/sys/class/leds/tsx:rgb:bar/raw'

DEST = 0x02
TYPE_DOWNLOAD = 0x04
TYPE_SREC = 0x0D
SUB_READY = 0x01
SUB_END_UPDATE = 0x02
SUB_PREPARE = 0x04
SUB_END_BLOCK = 0x05
SUB_ABORT = 0x06
PKT_PREPARE = bytes([DEST, 0x02, TYPE_DOWNLOAD, SUB_PREPARE])
PKT_END_BLOCK = bytes([DEST, 0x02, TYPE_DOWNLOAD, SUB_END_BLOCK])
PKT_END_UPDATE = bytes([DEST, 0x02, TYPE_DOWNLOAD, SUB_END_UPDATE])
# one record goes in one USB packet of 64 bytes: DEST, length, TYPE_SREC, body
MAX_BODY = 64 - 3


def log(msg):
    print('%s %s' % (time.strftime('%H:%M:%S'), msg), flush=True)


def die(msg):
    print('tsx-ledbar-flash: %s' % msg, file=sys.stderr, flush=True)
    sys.exit(1)


def load_upg_module():
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (here, '/usr/local/lib/tsx-ledbar-fw'):
        p = os.path.join(d, 'tsx-upg.py')
        if os.path.exists(p):
            spec = importlib.util.spec_from_file_location('tsx_upg', p)
            m = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(m)
            return m
    die('tsx-upg.py not found next to this script')


# ---- usbdevfs ---------------------------------------------------------------

PTR = ctypes.sizeof(ctypes.c_void_p)


def _IOC(d, t, n, s):
    return (d << 30) | (s << 16) | (ord(t) << 8) | n


IOC_CLAIM = _IOC(2, 'U', 15, 4)
IOC_RELEASE = _IOC(2, 'U', 16, 4)
IOC_BULK = _IOC(3, 'U', 2, 16 if PTR == 4 else 24)
IOC_CONTROL = _IOC(3, 'U', 0, 16 if PTR == 4 else 24)
GONE_ERRNOS = (errno.ENODEV, errno.ESHUTDOWN, errno.ECONNRESET, errno.ENOENT, errno.EPIPE)


class Bulk(ctypes.Structure):
    _fields_ = [('ep', ctypes.c_uint), ('len', ctypes.c_uint),
                ('timeout', ctypes.c_uint), ('data', ctypes.c_void_p)]


class Ctrl(ctypes.Structure):
    _fields_ = [('bRequestType', ctypes.c_ubyte), ('bRequest', ctypes.c_ubyte),
                ('wValue', ctypes.c_ushort), ('wIndex', ctypes.c_ushort),
                ('wLength', ctypes.c_ushort), ('timeout', ctypes.c_uint),
                ('data', ctypes.c_void_p)]


class Bar:
    """One USB device of the bar, in application or bootloader mode.
    open() claims one interface: 0 (console, or the bootloader) with the
    endpoints 0x01/0x81, or 1 (Cresnet io) with 0x02/0x82."""

    def __init__(self, sysname, devnode, pid):
        self.sysname, self.devnode, self.pid = sysname, devnode, pid
        self.fd = None
        self.gone = False
        self.iface = 0
        self.ep_out, self.ep_in = 0x01, 0x81

    @staticmethod
    def find():
        for d in sorted(glob.glob('/sys/bus/usb/devices/*')):
            try:
                with open(d + '/idVendor') as f:
                    if f.read().strip() != VID:
                        continue
                with open(d + '/idProduct') as f:
                    pid = f.read().strip()
                with open(d + '/busnum') as f:
                    bus = int(f.read())
                with open(d + '/devnum') as f:
                    dev = int(f.read())
            except OSError:
                continue
            return Bar(os.path.basename(d), '/dev/bus/usb/%03d/%03d' % (bus, dev), pid)
        return None

    @property
    def is_app(self):
        return self.pid == PID_APP

    def open(self, iface=0):
        self.iface = iface
        self.ep_out, self.ep_in = (0x01, 0x81) if iface == 0 else (0x02, 0x82)
        self.fd = os.open(self.devnode, os.O_RDWR)
        fcntl.ioctl(self.fd, IOC_CLAIM, struct.pack('I', iface))
        return self

    def close(self):
        if self.fd is not None:
            try:
                fcntl.ioctl(self.fd, IOC_RELEASE, struct.pack('I', self.iface))
            except OSError:
                pass
            os.close(self.fd)
            self.fd = None

    def string(self, idx):
        buf = ctypes.create_string_buffer(255)
        c = Ctrl(0x80, 6, 0x0300 | idx, 0x0409, 255, 1000, ctypes.cast(buf, ctypes.c_void_p))
        try:
            n = fcntl.ioctl(self.fd, IOC_CONTROL, c)
        except OSError:
            return ''
        raw = buf.raw[:n]
        if n < 2 or raw[1] != 3:
            return ''
        return raw[2:raw[0]].decode('utf-16-le', 'replace')

    def write(self, data):
        buf = ctypes.create_string_buffer(bytes(data), len(data))
        b = Bulk(self.ep_out, len(data), 2000, ctypes.cast(buf, ctypes.c_void_p))
        try:
            return fcntl.ioctl(self.fd, IOC_BULK, b)
        except OSError as e:
            if e.errno in GONE_ERRNOS:
                self.gone = True
                return 0
            raise

    def read(self, timeout_ms=200, n=64):
        """One bulk IN transfer of one packet. A transfer of one packet
        completes as soon as the packet arrives: a larger transfer would
        wait for a short packet, and usbfs drops the data of a transfer
        that times out."""
        buf = ctypes.create_string_buffer(n)
        b = Bulk(self.ep_in, n, timeout_ms, ctypes.cast(buf, ctypes.c_void_p))
        try:
            r = fcntl.ioctl(self.fd, IOC_BULK, b)
        except OSError as e:
            if e.errno == errno.ETIMEDOUT:
                return b''
            if e.errno in GONE_ERRNOS:
                self.gone = True
                return b''
            raise
        return buf.raw[:r]

    def drain(self, ms):
        out = b''
        end = time.monotonic() + ms / 1000.0
        while time.monotonic() < end and not self.gone:
            out += self.read(200)
        return out

    def command(self, line, ms=1500):
        """Send one console text line and return the answer of the next ms."""
        self.drain(200)
        self.write((line + '\r\n').encode())
        return self.drain(ms).decode('latin-1')


def wait_for(pred, timeout_s, what):
    """Wait for a bar that matches pred. Prints one line per 5 s."""
    end = time.monotonic() + timeout_s
    shown = time.monotonic()
    while time.monotonic() < end:
        bar = Bar.find()
        if bar and pred(bar):
            return bar
        if time.monotonic() - shown > 5:
            log('waiting for %s ...' % what)
            shown = time.monotonic()
        time.sleep(0.25)
    return None


def port_disable_path(bar=None):
    """The sysfs "disable" file of the root hub port the bar is on."""
    if bar and '-' in bar.sysname and ':' not in bar.sysname:
        bus, port = bar.sysname.split('-', 1)
        if '.' not in port:
            p = '/sys/bus/usb/devices/usb%s/%s-0:1.0/usb%s-port%s/disable' % (bus, bus, bus, port)
            if os.path.exists(p):
                return p
    for p in sorted(glob.glob('/sys/bus/usb/devices/usb*/*-0:1.0/usb*-port1/disable')):
        return p
    return None


def port_reset(bar=None, off_s=3.0):
    p = port_disable_path(bar)
    if p is None:
        die('no USB port power control found')
    log('USB port disabled (%s)' % p)
    with open(p, 'w') as f:
        f.write('1')
    time.sleep(off_s)
    log('USB port enabled')
    with open(p, 'w') as f:
        f.write('0')
    return wait_for(lambda b: True, 20, 'the bar after the port reset')


# ---- service ----------------------------------------------------------------

class Service:
    def __init__(self, keep):
        self.stopped = False
        self.keep = keep

    def stop(self):
        if self.keep or not os.path.exists(SERVICE):
            return
        r = subprocess.run(['rc-service', 'tsx-ledbar', 'status'], capture_output=True)
        if r.returncode != 0:
            return
        log('stopping the tsx-ledbar service')
        subprocess.run(['rc-service', 'tsx-ledbar', 'stop'], capture_output=True)
        self.stopped = True

    def start(self):
        if self.stopped:
            log('starting the tsx-ledbar service')
            subprocess.run(['rc-service', 'tsx-ledbar', 'start'], capture_output=True)
            self.stopped = False


# ---- application mode: the prepare packet ------------------------------------

def send_io_packet(bar, pkt):
    """Send one Cresnet packet on interface 1: through the kernel driver's
    raw attribute when it is bound, otherwise with usbdevfs."""
    if os.path.exists(LED_RAW):
        try:
            with open(LED_RAW, 'wb') as f:
                f.write(pkt)
        except OSError as e:
            die('cannot write %s: %s' % (LED_RAW, e))
        return 'driver raw attribute'
    try:
        bar.open(1)
    except OSError as e:
        bar.close()
        if e.errno == errno.EBUSY:
            die('cannot claim USB interface 1 of the bar: a kernel driver holds it, but %s does not exist. '
                'The driver is another version. Unbind it or update it, then try again' % LED_RAW)
        die('cannot open USB interface 1 of the bar: %s' % e)
    try:
        bar.write(pkt)
    except OSError as e:
        die('cannot send on USB interface 1 of the bar: %s' % e)
    finally:
        bar.close()
    return 'usbdevfs interface 1'


def enter_bootloader(bar, service):
    service.stop()
    bar.open(0)
    try:
        log('bar %s in application mode, firmware "%s"' % (bar.sysname, bar.string(4)))
    finally:
        bar.close()
    how = send_io_packet(bar, PKT_PREPARE)
    log('sent the prepare packet %s (%s)' % (PKT_PREPARE.hex(' '), how))
    gone = wait_for(lambda b: b.sysname != bar.sysname or b.devnode != bar.devnode or not b.is_app,
                    15, 'the bar to restart')
    if gone is None:
        die('the bar did not restart after the prepare packet')
    return wait_for(lambda b: not b.is_app, 20, 'the bootloader')


# ---- bootloader mode: the upload ---------------------------------------------

def pkt_text(p):
    return p.hex(' ') if p else '(nothing)'


def wait_ready(bar, timeout_s=10):
    """Read until the ready packet (type 04, sub-type 01, block size).
    Returns the block size. Reads on until the bar goes quiet."""
    time.sleep(0.1)
    end = time.monotonic() + timeout_s
    size = None
    while time.monotonic() < end:
        p = bar.read(1000)
        if not p:
            if size is not None:
                return size
            continue
        log('bootloader: %s' % pkt_text(p))
        if len(p) >= 4 and p[2] == TYPE_DOWNLOAD and p[3] == SUB_ABORT:
            die('the bootloader aborted')
        if len(p) == 5 and p[2] == TYPE_DOWNLOAD and p[3] == SUB_READY:
            size = 1 << p[4]
            log('bootloader ready, block size %d' % size)
            end = time.monotonic() + 3
    if size is None:
        die('no ready packet from the bootloader')
    return size


def end_block(bar, tries=60):
    bar.write(PKT_END_BLOCK)
    for _ in range(tries):
        p = bar.read(1000)
        if not p:
            continue
        if len(p) >= 4 and p[2] == TYPE_DOWNLOAD:
            if p[3] == SUB_READY:
                return
            if p[3] == SUB_ABORT:
                die('the bootloader aborted the update (%s)' % pkt_text(p))
        log('bootloader: %s (not the block acknowledgement)' % pkt_text(p))
    die('no acknowledgement after the end-of-block packet')


def srec_packet(body):
    """body = the record bytes after the count: address, data, checksum."""
    return bytes([DEST, len(body) + 1, TYPE_SREC]) + body


def upload(bar, records):
    """records: [(addr, body)] with the tag record first."""
    size = wait_ready(bar)
    t0 = time.monotonic()
    tag_addr, tag_body = records[0]
    bar.write(srec_packet(tag_body))
    end_block(bar)
    log('tag record accepted (%d data records follow)' % (len(records) - 1))
    blocks = 1
    block_start = None
    n = len(records) - 1
    for i, (addr, body) in enumerate(records[1:], 1):
        # A new block starts at a record above the block start plus the
        # block size. A record at exactly that address stays in the block.
        # The vendor host (DmFwUpload in libCNETTransport.so) does the same.
        if block_start is None:
            block_start = addr
        elif addr > block_start + size:
            end_block(bar)
            blocks += 1
            block_start = addr
            if blocks % 16 == 0:
                log('record %d/%d (%d%%), %d blocks' % (i, n, 100 * i // n, blocks))
        bar.write(srec_packet(body))
        if bar.gone:
            die('the bar left the bus during the upload (record %d)' % i)
    bar.write(PKT_END_UPDATE)
    log('all %d records sent in %d blocks, %.1f s, end of update sent' % (n, blocks, time.monotonic() - t0))
    tail = bar.drain(1000)
    if tail:
        log('bootloader: %s' % pkt_text(tail))


def read_records(path, upg):
    """The records of the .upg as (addr, body bytes). The body is the
    record after its count byte: address, data and checksum. A body must
    fit one USB packet with the 3 bytes in front of it."""
    with open(path, 'rb') as f:
        text = f.read().decode('ascii', 'replace')
    out = []
    for line in text.replace('\r', '\n').split('\n'):
        if not line:
            continue
        t, addr, data = upg.parse_record(line)
        body = bytes.fromhex(line[2:])[1:]
        if len(body) > MAX_BODY:
            raise upg.UpgError('the record at 0x%08X has %d bytes after the count, one USB packet takes %d'
                               % (addr, len(body), MAX_BODY))
        out.append((addr, body))
    return out


# ---- commands ---------------------------------------------------------------

def show_text(text, prefix='  '):
    for l in text.replace('\r', '').split('\n'):
        if l.strip():
            print(prefix + l, flush=True)


def cmd_info(args):
    bar = Bar.find()
    if bar is None:
        die('no LED bar on USB (14be:*)')
    bar.open(0)
    try:
        print('device    %s (%s) 14be:%s' % (bar.sysname, bar.devnode, bar.pid))
        for i in range(1, 5):
            print('string %d  %s' % (i, bar.string(i)))
        if bar.is_app:
            print('mode      application')
            text = bar.command('VER', 1000)
            show_text(text, 'ver       ')
            if 'TSX-LEDBAR' in text:
                show_text(bar.command('CAPS', 1000), 'caps      ')
        else:
            print('mode      bootloader')
    finally:
        bar.close()


def cmd_console(args):
    bar = Bar.find()
    if bar is None:
        die('no LED bar on USB')
    if not bar.is_app:
        die('the bar is in bootloader mode')
    bar.open(0)
    try:
        show_text(bar.command(' '.join(args.line), args.ms), '')
    finally:
        bar.close()


def cmd_btl_read(args):
    bar = Bar.find()
    if bar is None:
        die('no LED bar on USB')
    if bar.is_app:
        die('the bar is in application mode')
    bar.open(0)
    try:
        end = time.monotonic() + args.ms / 1000.0
        while time.monotonic() < end:
            p = bar.read(500)
            if p:
                log('bootloader: %s' % pkt_text(p))
    finally:
        bar.close()


def cmd_enter(args):
    bar = Bar.find()
    if bar is None:
        die('no LED bar on USB')
    if not bar.is_app:
        log('the bar is already in bootloader mode')
        return
    service = Service(args.keep_service)
    try:
        bar = enter_bootloader(bar, service)
        if bar is None:
            die('the bootloader did not enumerate')
    except BaseException:
        service.start()
        raise
    log('bootloader on %s as 14be:%s' % (bar.sysname, bar.pid))
    if service.stopped:
        log('the tsx-ledbar service stays stopped while the bar is in bootloader mode. '
            'After a load with "tsx-ledbar-flash flash FILE.upg", start it: rc-service tsx-ledbar start')


def cmd_port_reset(args):
    bar = port_reset(Bar.find())
    if bar is None:
        die('the bar did not come back after the port reset')
    bar.open(0)
    try:
        log('bar %s up as 14be:%s, string 4 "%s"' % (bar.sysname, bar.pid, bar.string(4)))
    finally:
        bar.close()


def cmd_flash(args):
    upg = load_upg_module()
    try:
        codes, recs = upg.read_upg(args.upg)
        base, img = upg.image_from_records(recs)
        checks = upg.check_image(img, base, codes)
        records = read_records(args.upg, upg)
    except (upg.UpgError, OSError) as e:
        die('%s: %s. Nothing sent' % (args.upg, e))
    bad = [c for c in checks if not c[1]]
    if bad:
        for name, ok, text in bad:
            print('  %-14s BAD  %s' % (name, text))
        die('%s failed its checks, nothing sent' % args.upg)
    hdr = upg.header_fields(img, base)
    log('image %s: version %d.%d.%d, %d bytes at 0x%08X, %d records, checks ok' % (
        args.upg, hdr['major'], hdr['minor'], hdr['build'], len(img), base, len(records)))

    bar = Bar.find()
    if bar is None:
        die('no LED bar on USB (14be:*)')
    service = Service(args.keep_service)
    try:
        if bar.is_app:
            bar = enter_bootloader(bar, service)
            if bar is None:
                die('the bootloader did not enumerate')
        else:
            service.stop()
            log('bar %s is already in bootloader mode (14be:%s)' % (bar.sysname, bar.pid))
        bar.open(0)
        try:
            log('bootloader on %s as 14be:%s, string 4 "%s"' % (bar.sysname, bar.pid, bar.string(4)))
            upload(bar, records)
        finally:
            bar.close()
        log('waiting for the new application')
        app = wait_for(lambda b: b.is_app and b.devnode != bar.devnode, 40, 'the application')
        if app is None:
            now = Bar.find()
            die('the application did not start (bar: %s). Run the flash again.' % (
                '14be:%s on %s, bootloader mode' % (now.pid, now.sysname) if now else 'not on USB'))
        app.open(0)
        try:
            fw = app.string(4)
            log('application up: "%s"' % fw)
            time.sleep(0.5)
            show_text(app.command('VER', 1000), '  ver: ')
            want = ['%d' % hdr['major'], '%d' % hdr['minor'], '%d' % hdr['build']]
            got = [str(int(x)) for x in ''.join(c if c.isdigit() else ' ' for c in fw).split()]
            if not all(w in got for w in want):
                log('WARNING: the version in the firmware name does not match the image header')
        finally:
            app.close()
        log('flash done')
    finally:
        service.start()


def main():
    import argparse
    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    p.add_argument('--keep-service', action='store_true', help='do not stop tsx-ledbar')
    sub = p.add_subparsers(dest='cmd', required=True)
    sub.add_parser('info')
    a = sub.add_parser('flash'); a.add_argument('upg')
    a = sub.add_parser('console'); a.add_argument('line', nargs='+'); a.add_argument('--ms', type=int, default=1500)
    a = sub.add_parser('btl-read'); a.add_argument('ms', type=int, nargs='?', default=3000)
    sub.add_parser('enter-bootloader')
    sub.add_parser('port-reset')
    args = p.parse_args()
    if os.geteuid() != 0:
        die('run as root (usbdevfs)')
    if args.cmd == 'info':
        cmd_info(args)
    elif args.cmd == 'flash':
        cmd_flash(args)
    elif args.cmd == 'console':
        cmd_console(args)
    elif args.cmd == 'btl-read':
        cmd_btl_read(args)
    elif args.cmd == 'enter-bootloader':
        cmd_enter(args)
    elif args.cmd == 'port-reset':
        cmd_port_reset(args)


if __name__ == '__main__':
    main()
